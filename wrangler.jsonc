// Cloudflare config for the live table server (party/server.ts).
// Local: npm run party:dev   Deploy: npm run party:deploy
{
  "name": "felt-tables",
  "main": "party/server.ts",
  "compatibility_date": "2026-10-01",
  "vars": {
    // public tables: bots fill open seats up to this many players while someone is seated (0 = no bots)
    "BOT_SEATS": "4",
    // accounts: the Supabase project that signs players in (both values are public). Leave empty to
    // keep live tables guest-only. Same values as VITE_SUPABASE_URL / VITE_SUPABASE_PUBLISHABLE_KEY.
    "SUPABASE_URL": "https://uiqbxzeemhojjmpoechp.supabase.co",
    "SUPABASE_PUBLISHABLE_KEY": "sb_publishable_HFZkRP585bnony3bWIVOTQ_-a5Ggsbl"
    // leaderboards also need the project's secret key, kept as a Cloudflare secret (never here):
    //   npx wrangler secret put SUPABASE_SECRET_KEY
  },
  "durable_objects": {
    "bindings": [
      { "name": "PokerTable", "class_name": "PokerTable" },
      // everyone's daily chips (one instance)
      { "name": "Bank", "class_name": "Bank" },
      // each signed-in player's ranked daily five and survival runs (one instance per player)
      { "name": "Puzzles", "class_name": "Puzzles" }
    ]
  },
  // the free plan only allows SQLite-backed Durable Objects
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["PokerTable"] },
    { "tag": "v2", "new_sqlite_classes": ["Bank"] },
    { "tag": "v3", "new_sqlite_classes": ["Puzzles"] }
  ]
}
