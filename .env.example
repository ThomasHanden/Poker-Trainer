# Copy to .env.local for local development. .env.local is ignored by git; never commit real secrets.

# Address of the live-table server (the Cloudflare Worker), without https://.
# Local: localhost:8787 (run `npm run party:dev`). Production: set in Vercel → Settings → Environment
# Variables (e.g. felt-tables.<your-subdomain>.workers.dev).
VITE_PARTY_HOST=localhost:8787

# The site's production address, used for canonical links, the sitemap and link previews,
# e.g. https://feltschool.com. Optional on Vercel, which provides the production domain itself;
# set it to choose a specific custom domain. Builds outside Vercel production are marked noindex.
SITE_URL=
